# Copy to .env and fill in. Never commit .env.

# --- Steam (Phase 1+) -----------------------------------------------------
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# 17-digit 64-bit SteamID (string, NOT numeric — JS Number can't hold it).
STEAM_ID=

# --- Auth: next-auth / Steam OpenID (Phase 6+) ----------------------------
# Server-only secrets — NEVER prefix with NEXT_PUBLIC_. See ADR 0002.
# NEXTAUTH_SECRET signs/encrypts the JWT session cookie. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical origin of this deployment; used to build the OpenID return_to URL.
NEXTAUTH_URL=http://localhost:3000

# --- Database (Phase 1+) --------------------------------------------------
# SQLite for local dev; Postgres for self-hosted prod.
DATABASE_URL="file:./dev.db"

# --- Cron (Phase 2+) ------------------------------------------------------
# Shared secret for cron route handlers, compared with crypto.timingSafeEqual.
CRON_SECRET=

# --- Cache (optional) ------------------------------------------------------
# Redis connection URL. When unset, falls back to an in-memory LRU cache
# (suitable for local dev). Set this for a persistent self-hosted deployment.
# REDIS_URL=redis://localhost:6379

# --- Free, opt-in enrichment (Phase 4) ------------------------------------
# Both OFF by default. Enabling them adds extra outbound calls to third parties
# (a privacy consideration for self-hosters). See docs/STEAM_DATA_SOURCES.md.
# SteamSpy genre/tag/ownership enrichment (#38): set to 1 to enable.
ENABLE_STEAMSPY=
# IsThereAnyDeal historical-low prices (#39): get a free key at
# https://isthereanydeal.com/apps/my/ — leave blank to keep the client disabled.
ITAD_API_KEY=

# --- Claude MCP servers (.mcp.json) ---------------------------------------
# Fine-grained GitHub token scoped to AlesSystems/4ES-Dash.
# Required by the `github` MCP server. See docs/MCP.md.
GITHUB_PERSONAL_ACCESS_TOKEN=
