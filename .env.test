# Placeholder env for Vitest. Shape-valid, NOT real secrets. Steam HTTP is
# intercepted by MSW (added in Section 2), so these values never reach the network.
STEAM_API_KEY=test_placeholder_key
STEAM_ID=76561190000000000
DATABASE_URL=file:./test.db
CRON_SECRET=test_placeholder_secret
# next-auth (Auth.js) — placeholders; JWT is signed with these in tests but no real auth happens.
NEXTAUTH_SECRET=test_placeholder_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000
