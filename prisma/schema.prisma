// 4ES-Dash persistence layer. See docs/DATA_MODEL.md for the reasoning.
//
// Provider is SQLite for dev/CI; production uses Postgres via `prisma db push`
// (schema-driven, no migration replay) — see docs/DEPLOYMENT.md. Committed
// migrations are SQLite-authored and immutable once merged.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev/CI; the rhel target is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite" // postgres in prod via `db push`; see docs/DEPLOYMENT.md
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

// Profile visibility level. Stored as a string by SQLite (no native enum);
// Postgres (prod) also stores as VARCHAR via `db push`. Default = private
// per ADR 0002 §4: a new account is hidden until the user opts in to sharing.
enum Privacy {
  public
  friendsOnly
  private
}

// ─── Reference tables (upserted on read-through) ───────────────────────────

model User {
  steamId      String   @id // 17-digit string, 64-bit Steam ID
  personaName  String
  avatarUrl    String
  countryCode  String?
  createdAt    DateTime
  firstSeenAt  DateTime @default(now())
  lastSyncedAt DateTime @default(now())
  // ── Phase 6 / multi-user identity (ADR 0002) ──
  lastLoginAt  DateTime?               // set on each sign-in; null before first login
  privacy      Privacy  @default(private) // profile visibility; opt-in sharing
  onboardedAt  DateTime?               // null until first backfill completes (Tasks 06/08)

  ownedGames           OwnedGame[]
  playtimeSnapshots    PlaytimeSnapshot[]
  achievementSnapshots AchievementSnapshot[]
}

model Game {
  appId       Int       @id
  name        String
  iconUrl     String?
  headerUrl   String?
  releaseDate DateTime?
  genres      String    // JSON-encoded array; expand to a join if we need to query by genre
  categoryIds String?   // JSON-encoded number array of Store category ids; null = never categorized by the nightly job
  hasStats    Boolean   @default(false)
  refreshedAt DateTime  @default(now())

  // Current Store price, refreshed OFF the request path by the nightly job
  // (refreshGameStoreData). Insights pages READ these instead of pricing every
  // game live on render (ERR-0011) — same precompute-and-read pattern as
  // LibraryValueAggregate. priceRefreshedAt is null until the first job run, so
  // cost-per-hour treats a null here as "price unavailable" (excluded), never $0.
  priceFinalCents  Int?      // current final price in minor units (cents); null = unknown/unavailable
  priceCurrency    String?   // ISO 4217 currency code for priceFinalCents
  priceIsFree      Boolean?  // true = free-to-play; false = paid; null = not yet priced
  priceRefreshedAt DateTime? // when price + genres were last refreshed; null = never

  owners       OwnedGame[]
  achievements Achievement[]
}

model OwnedGame {
  steamId          String
  appId            Int
  acquiredAt       DateTime? // NOT returned by GetOwnedGames; inferred from first snapshot only
  playtimeForever  Int       // minutes
  playtimeTwoWeeks Int       // minutes, snapshot of "last 2 weeks"
  lastPlayedAt     DateTime?
  refreshedAt      DateTime  @default(now())

  user User @relation(fields: [steamId], references: [steamId])
  game Game @relation(fields: [appId], references: [appId])

  @@id([steamId, appId])
  @@index([steamId, playtimeForever])
}

model Achievement {
  appId               Int
  apiName             String
  displayName         String
  description         String?
  iconUrl             String?
  iconGrayUrl         String?
  globalUnlockPercent Float?

  game Game @relation(fields: [appId], references: [appId])

  @@id([appId, apiName])
}

// ─── Snapshot tables (append-only, day-keyed) ──────────────────────────────

model PlaytimeSnapshot {
  steamId         String
  appId           Int
  date            DateTime // truncated to day, UTC
  playtimeForever Int      // minutes, monotonic

  user User @relation(fields: [steamId], references: [steamId])

  @@id([steamId, appId, date])
  @@index([steamId, date])
}

model AchievementSnapshot {
  steamId       String
  appId         Int
  date          DateTime
  unlockedCount Int

  user User @relation(fields: [steamId], references: [steamId])

  @@id([steamId, appId, date])
}

// Per-achievement unlock EVENT, keyed by the real unlock time (#91). Unlike the
// cumulative-count AchievementSnapshot, this records WHEN each achievement was
// unlocked, so Year-in-Review can count unlocks by their UTC year without
// needing a snapshot history (a single day of data still yields a correct
// count). Written by the nightly job + onboarding backfill from Steam's
// unlocktime (unix SECONDS × 1000). unlocktime 0 ("time unknown") is excluded
// at write time, so a row's unlockedAt is always a real timestamp. Keyed by
// (steamId, appId, apiName) so re-recording the same unlock is idempotent.
model AchievementUnlock {
  steamId    String
  appId      Int
  apiName    String
  unlockedAt DateTime

  @@id([steamId, appId, apiName])
  @@index([steamId, unlockedAt])
}

// Pre-computed library-value aggregate (#85). Pricing every owned game via the
// Store API is O(N) rate-limited calls; doing it on the dashboard render path
// made cold loads scale with library size. The nightly job computes this once
// (off the request path) and the dashboard READS this single row — its Steam
// fan-out is then bounded and independent of N. A missing row → the UI shows a
// designed "value pending" state (never a synchronous live fan-out, never $0).
model LibraryValueAggregate {
  steamId      String   @id
  totalMinor   Int // sum of finalCents across priced games
  currency     String // ISO code from the first priced game; '' if none priced
  pricedCount  Int
  freeCount    Int
  missingCount Int // games whose Store price was unavailable at compute time
  computedAt   DateTime @default(now())
}

// ─── Manual / enrichment data (Phase 4) ────────────────────────────────────

// User-supplied data Steam never exposes (price paid, acquisition date) — see
// #40. Kept separate from OwnedGame so the *inferred* acquiredAt (first
// snapshot) is never overwritten by an import, and so cost-per-hour can prefer
// real price-paid over current store price when present. (steamId, appId) is
// the natural unique key.
model ManualGameData {
  // No FK to OwnedGame by design — an import may precede the first snapshot run.
  steamId        String
  appId          Int
  pricePaidCents Int? // what the user actually paid, in minor units
  currency       String? // ISO 4217 of pricePaidCents (e.g. "USD")
  acquiredAt     DateTime? // real acquisition date supplied by the user
  importedAt     DateTime  @default(now())

  @@id([steamId, appId])
}

// A dismissed idle-detection flag (#37). Keyed by the exact spike window so a
// *new* spike (different window) re-surfaces the game; dismissing one window
// never hides a future one.
model IdleDismissal {
  steamId     String
  appId       Int
  fromDate    DateTime
  toDate      DateTime
  dismissedAt DateTime @default(now())

  @@id([steamId, appId, fromDate, toDate])
  @@index([steamId, appId])
}

// ─── Observability ─────────────────────────────────────────────────────────

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    // queued | running | ok | error
  error      String?
  payload    String?   // JSON
}
