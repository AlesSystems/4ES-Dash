// 4ES-Dash persistence layer. See docs/DATA_MODEL.md for the reasoning.
//
// Provider is SQLite for dev/CI; production uses Postgres via `prisma db push`
// (schema-driven, no migration replay) — see docs/DEPLOYMENT.md. Committed
// migrations are SQLite-authored and immutable once merged.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev/CI; the rhel target is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite" // postgres in prod via `db push`; see docs/DEPLOYMENT.md
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

// Profile visibility level. Stored as a string by SQLite (no native enum);
// Postgres (prod) also stores as VARCHAR via `db push`. Default = private
// per ADR 0002 §4: a new account is hidden until the user opts in to sharing.
enum Privacy {
  public
  friendsOnly
  private
}

// ─── Reference tables (upserted on read-through) ───────────────────────────

model User {
  steamId      String   @id // 17-digit string, 64-bit Steam ID
  personaName  String
  avatarUrl    String
  countryCode  String?
  createdAt    DateTime
  firstSeenAt  DateTime @default(now())
  lastSyncedAt DateTime @default(now())
  // ── Phase 6 / multi-user identity (ADR 0002) ──
  lastLoginAt  DateTime?               // set on each sign-in; null before first login
  privacy      Privacy  @default(private) // profile visibility; opt-in sharing
  onboardedAt  DateTime?               // null until first backfill completes (Tasks 06/08)

  ownedGames           OwnedGame[]
  playtimeSnapshots    PlaytimeSnapshot[]
  achievementSnapshots AchievementSnapshot[]
}

model Game {
  appId       Int       @id
  name        String
  iconUrl     String?
  headerUrl   String?
  releaseDate DateTime?
  genres      String    // JSON-encoded array; expand to a join if we need to query by genre
  hasStats    Boolean   @default(false)
  refreshedAt DateTime  @default(now())

  owners       OwnedGame[]
  achievements Achievement[]
}

model OwnedGame {
  steamId          String
  appId            Int
  acquiredAt       DateTime? // NOT returned by GetOwnedGames; inferred from first snapshot only
  playtimeForever  Int       // minutes
  playtimeTwoWeeks Int       // minutes, snapshot of "last 2 weeks"
  lastPlayedAt     DateTime?
  refreshedAt      DateTime  @default(now())

  user User @relation(fields: [steamId], references: [steamId])
  game Game @relation(fields: [appId], references: [appId])

  @@id([steamId, appId])
  @@index([steamId, playtimeForever])
}

model Achievement {
  appId               Int
  apiName             String
  displayName         String
  description         String?
  iconUrl             String?
  iconGrayUrl         String?
  globalUnlockPercent Float?

  game Game @relation(fields: [appId], references: [appId])

  @@id([appId, apiName])
}

// ─── Snapshot tables (append-only, day-keyed) ──────────────────────────────

model PlaytimeSnapshot {
  steamId         String
  appId           Int
  date            DateTime // truncated to day, UTC
  playtimeForever Int      // minutes, monotonic

  user User @relation(fields: [steamId], references: [steamId])

  @@id([steamId, appId, date])
  @@index([steamId, date])
}

model AchievementSnapshot {
  steamId       String
  appId         Int
  date          DateTime
  unlockedCount Int

  user User @relation(fields: [steamId], references: [steamId])

  @@id([steamId, appId, date])
}

// ─── Manual / enrichment data (Phase 4) ────────────────────────────────────

// User-supplied data Steam never exposes (price paid, acquisition date) — see
// #40. Kept separate from OwnedGame so the *inferred* acquiredAt (first
// snapshot) is never overwritten by an import, and so cost-per-hour can prefer
// real price-paid over current store price when present. (steamId, appId) is
// the natural unique key.
model ManualGameData {
  // No FK to OwnedGame by design — an import may precede the first snapshot run.
  steamId        String
  appId          Int
  pricePaidCents Int? // what the user actually paid, in minor units
  currency       String? // ISO 4217 of pricePaidCents (e.g. "USD")
  acquiredAt     DateTime? // real acquisition date supplied by the user
  importedAt     DateTime  @default(now())

  @@id([steamId, appId])
}

// A dismissed idle-detection flag (#37). Keyed by the exact spike window so a
// *new* spike (different window) re-surfaces the game; dismissing one window
// never hides a future one.
model IdleDismissal {
  steamId     String
  appId       Int
  fromDate    DateTime
  toDate      DateTime
  dismissedAt DateTime @default(now())

  @@id([steamId, appId, fromDate, toDate])
  @@index([steamId, appId])
}

// ─── Observability ─────────────────────────────────────────────────────────

model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    // queued | running | ok | error
  error      String?
  payload    String?   // JSON
}
